{
  "name": "maxen-windows-player",
  "version": "2.6.2",
  "description": "Maxen Windows masaüstü oynatıcısı",
  "author": "Laze Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.laze.maxen.player",
    "productName": "Maxen",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "downloads.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "../assets/images/maxen.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Maxen-Setup-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
